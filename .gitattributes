# Auto detect text files and perform LF normalization
* text=auto

# Files used inside Linux containers must keep LF line endings,
# also when the repository is checked out on Windows
Dockerfile   text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.conf       text eol=lf
*.R          text eol=lf
.dockerignore text eol=lf
